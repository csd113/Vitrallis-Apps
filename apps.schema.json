{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vitrallis app catalog v1",
  "description": "Repository metadata for version checks; installer support is separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "apps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "apps": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version",
          "description",
          "runtime",
          "entry",
          "permissions",
          "installable",
          "compatibility_notes",
          "source",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "version": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "runtime": {
            "const": "python"
          },
          "entry": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "network",
              "audio",
              "storage"
            ],
            "properties": {
              "network": {
                "type": "boolean"
              },
              "audio": {
                "type": "boolean"
              },
              "storage": {
                "type": "boolean"
              }
            }
          },
          "installable": {
            "type": "boolean"
          },
          "compatibility_notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "commit",
              "path"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "maxLength": 140,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}/(?!\\.{1,2}$)[A-Za-z0-9_.-]{1,100}$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "path": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^apps/[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "size",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 240,
                  "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2097152
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
